#include<bits/stdc++.h>
using namespace std;
int knapsack(vector<int>&weights,vector<int>&values,int n,int m){
vector<vector<int>>dp(n+1,vector<int>(m+1,0));
 for(int i=1;i<=n;i++){
  for(int w=0;w<=m;w++){
  	if(weights[i-1]>w){
  	dp[i][w]=dp[i-1][w];
  	}
  	else 
  	{
  		dp[i][w]=max(dp[i-1][w],values[i-1]+dp[i-1][w-weights[i-1]]);
	  }
   }
 }
   return dp[n][m];
}
 int main()
 {
 	int n;
 	cout<<"enter number of items:";
 	cin>>n;
 	vector<int>weights(n),values(n);
 	cout<<"enter the weights:";
 	for(int i=0;i<n;i++)
 	{
 		cin>>weights[i];
	 }
	 cout<<"enter the values:";
	 for(int i=0;i<n;i++)
	 {
	 	cin>>values[i];
	 }
	  int m;
	  cout<<"enter capacity:";
	  cin>>m;
	  int result=knapsack(weights,values,n,m);
	  cout<<"maximum value:"<<result;
	  return 0;
 }
