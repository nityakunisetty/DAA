#include<bits/stdc++.h>
#include<vector>
using namespace std;
struct Node {
	int val;
	Node* left, *right;
	Node(int v) : val(v), left(NULL) , right(NULL) {}
};
Node * buildtree() {
	int rootval;
	cout<<"enter root value: ";
	cin>>rootval;
	if(rootval==-1) return NULL;
	Node* root= new Node(rootval);
	queue<Node*>q;
	q.push(root);
	while(!q.empty()) {
		Node*curr= q.front();
		q.pop();
		int leftval, rightval;
		cout<<"enter left child of: "<<curr->val;
		cin>>leftval;
		if(leftval!=-1) {
		curr->left= new Node(leftval);
		q.push(curr->left);
	}
	cout<<"enter right child of: "<<curr->val;
	cin>>rightval;
	if (rightval != -1) {
    curr->right = new Node(rightval);
    q.push(curr->right);
}

}
return root;
}
void preorder(Node *r) { 
if (!r) return; 
cout << r->val << " ";
preorder(r->left); 
preorder(r->right); 
 }
 void inorder(Node *r) {
 	if(!r) return;
 	inorder(r->left);
 	cout<<r->val<<" ";
 	inorder(r->right);
 }
 void postorder(Node *r) {
 	if(!r) return;
 	postorder(r->left);
 	postorder(r->right);
 	cout<<r->val<<" ";
 }
 void levelOrder(Node * root) {
    if (!root) return;
    queue<Node*> q;
    q.push(root);
    while (!q.empty()) {
        int levelSize = q.size();
        for (int i = 0; i < levelSize; i++) {
            Node* curr = q.front(); q.pop();
            cout << curr->val << " ";
            if (curr->left)  q.push(curr->left);
            if (curr->right) q.push(curr->right);
        }
        cout << "| ";
    }
}
int main() {
    Node* root = buildtree();
    cout << "\nPreorder:   "; preorder(root);
    cout << "\nInorder:    "; inorder(root);
    cout << "\nPostorder:  "; postorder(root);
    cout << "\nLevelOrder: "; levelOrder(root);
    cout << endl;
    return 0;
}
